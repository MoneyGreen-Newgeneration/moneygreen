# --- Serveur ---
PORT=5000

# --- Base de données MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/moneygreen

# --- JWT ---
JWT_SECRET=moneygreen_secret

# --- CORS ---
# Origine(s) autorisée(s) à appeler l'API / se connecter en Socket.io.
# Plusieurs origines : les séparer par des virgules, sans espace.
# Exemple prod : CORS_ORIGIN=https://moneygreen.example.com
CORS_ORIGIN=http://localhost:3000

# --- Cloudinary (upload d'images) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Emailing (Nodemailer / Gmail) ---
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
