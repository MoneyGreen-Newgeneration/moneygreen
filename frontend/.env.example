# Variables d'environnement du frontend (React / CRA).
# Copier ce fichier vers ".env" à la racine du dossier frontend/
# (celui qui contient package.json de l'app React) avant de builder.
#
# Attention : avec Create React App, ces variables doivent commencer
# par REACT_APP_ pour être injectées au build, et le serveur de dev
# doit être redémarré après toute modification.

REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000
